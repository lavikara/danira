generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id                     String                   @id @default(uuid())
  username               String                   @unique
  email                  String                   @unique
  password               String
  firstName              String
  lastName               String
  designation            String?
  phoneNumber            String
  country                String
  state                  String
  address                String
  isVerified             Boolean
  gender                 Gender
  role                   Role
  status                 UserCondition
  ratings                Float                    @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  admins                 Admins?
  staffs                 Staffs?
  students               Students?
  guardians              Guardians?
  notificationRecipients NotificationRecipients[]
}

model Admins {
  id        String        @id @default(uuid())
  userId    String        @unique
  type      SchoolSetup?
  schoolIds String[]
  schools   Schools[]
  groupId   String?
  group     SchoolGroups? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  users     Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolGroups {
  id        String       @id @default(uuid())
  groupName String       @unique
  status    SchoolStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admins    Admins[]
  schools   Schools[]
}

model Schools {
  id                 String              @id @default(uuid())
  type               SchoolType
  setup              SchoolSetup
  schoolName         String              @unique
  regNumber          String?
  address            String
  phoneNumber        String
  country            String
  state              String
  createdBy          String?
  approvedBy         String?
  isApproved         Boolean
  termsConditions    Boolean
  status             SchoolStatus
  email              String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  classes            Classes[]
  staffs             Staffs[]
  students           Students[]
  admins             Admins[]
  departments        Departments[]
  subjects           Subjects[]
  feeStructures      FeeStructures[]
  fees               Fees[]
  feeInvoices        FeeInvoice[]
  receipts           Receipt[]
  timetables         Timetables[]
  terms              Terms[]
  groupId            String?
  group              SchoolGroups?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  studentAttendances StudentAttendance[]
  staffAttendances   StaffAttendance[]
  notifications      Notifications[]
}

model Departments {
  id          String           @id @default(uuid())
  name        String
  code        String?
  description String?
  status      DepartmentStatus @default(ACTIVE)
  schoolId    String
  school      Schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  headId      String?          @unique
  head        Staffs?          @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  staffs      Staffs[]         @relation("DepartmentStaffs")
  subjects    Subjects[]
  classes     Classes[]
  students    Students[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([schoolId, name])
}

model Staffs {
  id                String             @id @default(uuid())
  staffId           String?
  position          String
  image             String?
  accomodation      Accomodation?
  employmentStatus  StaffStatus
  subjectOfferings  ClassSubjects[]
  classes           Classes[]
  lessons           Lessons[]
  receiptsIssued    Receipt[]
  schoolId          String
  school            Schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId            String             @unique
  users             Users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Departments?       @relation("DepartmentStaffs", fields: [departmentId], references: [id], onDelete: SetNull)
  headOfDepartment  Departments?       @relation("DepartmentHead")
  staffAttendances  StaffAttendance[]
  lessonAttendances LessonAttendance[]
}

model Students {
  id           String              @id @default(uuid())
  position     String
  studentId    String?
  image        String?
  accomodation Accomodation?
  attendances  StudentAttendance[]
  reportCard   ReportCards[]
  fees         Fees[]
  feeInvoices  FeeInvoice[]
  receipts     Receipt[]
  classId      String
  classInfo    Classes             @relation(fields: [classId], references: [id], onDelete: Restrict)
  guardianId   String
  guardian     Guardians           @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  schoolId     String?
  school       Schools?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  gradeYearId  String?
  gradeYear    GradeYears?         @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  examId       String?
  exam         Exams?              @relation(fields: [examId], references: [id], onDelete: SetNull)
  testId       String?
  test         Tests?              @relation(fields: [testId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignments?        @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  subjects     Subjects[]
  departmentId String?
  department   Departments?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId       String              @unique
  users        Users               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guardians {
  id       String     @id @default(uuid())
  userId   String     @unique
  students Students[]
  users    Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Classes {
  id               String          @id @default(uuid())
  name             String
  type             ClassType
  status           ClassCondition
  description      String?
  population       Int
  supervisorId     String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  supervisor       Staffs          @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  lessons          Lessons[]
  subjectOfferings ClassSubjects[]
  students         Students[]
  events           Events[]
  announcements    Announcements[]
  fees             Fees[]
  feeInvoices      FeeInvoice[]
  timetables       Timetables[]
  gradeYearId      String?
  gradeYear        GradeYears?     @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Departments?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  school           Schools?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId         String?
}

model Timetables {
  id          String             @id @default(uuid())
  name        String
  status      Duration           @default(UPCOMING)
  schoolId    String
  school      Schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String?
  classInfo   Classes?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  gradeYearId String?
  gradeYear   GradeYears?        @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  termId      String?
  term        Terms?             @relation(fields: [termId], references: [id], onDelete: SetNull)
  periods     TimetablePeriods[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([schoolId, classId, termId])
}

model TimetablePeriods {
  id          String     @id @default(uuid())
  name        String
  day         Day
  startTime   DateTime
  endTime     DateTime
  periodType  PeriodType
  timetableId String
  timetable   Timetables @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lessons?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([timetableId, day, startTime])
}

model Assignments {
  id        String     @id @default(uuid())
  title     String
  startTime DateTime
  dueDate   DateTime
  status    Duration
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lessons   Lessons[]
  students  Students[]
}

model Exams {
  id        String     @id @default(uuid())
  title     String
  status    Duration
  startTime DateTime
  endTime   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  subjects  Subjects[]
  students  Students[]
}

model Tests {
  id        String     @id @default(uuid())
  title     String
  status    Duration
  startTime DateTime
  endTime   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  subjects  Subjects[]
  students  Students[]
}

model GradeYears {
  id         String       @id @default(uuid())
  level      String
  start      DateTime
  end        DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  students   Students[]
  classes    Classes[]
  terms      Terms[]
  timetables Timetables[]
}

model Terms {
  id            String          @id @default(uuid())
  name          String
  start         DateTime
  end           DateTime
  status        Duration
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  type          TermType
  gradeYearId   String?
  gradeYear     GradeYears?     @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  timetables    Timetables[]
  fees          Fees[]
  feeInvoices   FeeInvoice[]
  school        Schools?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId      String?
  feeStructures FeeStructures[]

  @@index([schoolId, status])
}

model StudentAttendance {
  id         String           @id @default(uuid())
  date       DateTime         @db.Date
  attendance AttendanceStatus
  clockIn    DateTime?
  clockOut   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  schoolId   String
  school     Schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Students         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lessons?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([studentId, lessonId, date])
  @@index([schoolId, date])
}

model StaffAttendance {
  id        String           @id @default(uuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  clockIn   DateTime?
  clockOut  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  schoolId  String
  school    Schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staffs           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([schoolId, date])
}

model LessonAttendance {
  id        String           @id @default(uuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  clockIn   DateTime?
  clockOut  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lessonId  String
  lesson    Lessons          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staffs           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([lessonId, staffId, date])
  @@index([staffId, date])
}

model Subjects {
  id           String          @id @default(uuid())
  name         String
  category     SubjectCategory
  description  String?
  code         String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  status       SubjectStatus
  students     Students[]
  exams        Exams[]
  tests        Tests[]
  reportCards  ReportCards[]
  offerings    ClassSubjects[]
  schoolId     String
  school       Schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Departments?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lessons      Lessons[]

  @@unique([schoolId, name])
  @@index([departmentId])
}

model ClassSubjects {
  id        String    @id @default(uuid())
  classId   String
  classInfo Classes   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subjects  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staffs?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  lessons   Lessons[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([staffId])
}

model Lessons {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  day                Day
  status             Duration
  startTime          DateTime
  endTime            DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  studentAttendances StudentAttendance[]
  lessonAttendances  LessonAttendance[]
  subject            Subjects            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId          String
  classInfo          Classes             @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId            String
  staff              Staffs              @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId            String
  classSubjectId     String?
  classSubject       ClassSubjects?      @relation(fields: [classSubjectId], references: [id], onDelete: SetNull)
  assignmentId       String?
  assignment         Assignments?        @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  timetablePeriods   TimetablePeriods[]
}

model ReportCards {
  id              String          @id @default(uuid())
  testScore       Float
  assignmentScore Float
  examScore       Float
  attendanceScore Float
  status          ReportCardState
  teacherComment  String
  generalComment  String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subjects        Subjects[]
  studentId       String?
  student         Students?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model FeeStructures {
  id          String      @id @default(uuid())
  name        String
  description String?
  currency    Currency
  category    FeeCategory
  amount      Float
  classType   ClassType?
  schoolId    String
  school      Schools     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId      String?
  term        Terms?      @relation(fields: [termId], references: [id], onDelete: SetNull)
  fees        Fees[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([schoolId, name])
}

model FeeInvoice {
  id               String    @id @default(uuid())
  invoiceNumber    String    @unique
  totalAmount      Float     @default(0)
  totalPaid        Float     @default(0)
  totalOutstanding Float     @default(0)
  currency         Currency
  status           FeeStatus
  notes            String?
  studentId        String
  student          Students  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId         String
  school           Schools   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId          String?
  classInfo        Classes?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  termId           String
  term             Terms     @relation(fields: [termId], references: [id], onDelete: Cascade)
  fees             Fees[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([studentId, termId])
  @@index([schoolId, status])
}

model Fees {
  id          String      @id @default(uuid())
  name        String
  description String?
  amount      Float
  paid        Float       @default(0)
  outstanding Float       @default(0)
  category    FeeCategory
  status      FeeStatus
  currency    Currency

  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  studentId String?
  student   Students? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  schoolId String
  school   Schools @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId   String?
  classInfo Classes? @relation(fields: [classId], references: [id], onDelete: SetNull)

  feeStructureId String?
  feeStructure   FeeStructures? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  termId String?
  term   Terms?  @relation(fields: [termId], references: [id], onDelete: SetNull)

  receiptId String?
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([termId])
  @@index([receiptId])
}

model Receipt {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  amount        Float
  currency      Currency
  paymentMethod PaymentMethod
  notes         String?
  studentId     String
  student       Students      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId      String
  school        Schools       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issuedById    String?
  issuedBy      Staffs?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  fees          Fees[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Events {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      Duration
  date        DateTime
  duration    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  classInfo   Classes? @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId     String?
}

model Announcements {
  id          String             @id @default(uuid())
  title       String
  description String?
  status      AnnouncementStatus
  date        DateTime
  classInfo   Classes?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Notifications {
  id         String                   @id @default(uuid())
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority     @default(NORMAL)
  icon       NotificationIcon
  bgColor    NotificationColor
  iconColor  NotificationColor
  // FIX: was optional + onDelete: Cascade — now consistent (SetNull), so deleting a
  // school doesn't wipe out notification history that might still need auditing.
  schoolId   String?
  school     Schools?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  entityType NotificationEntityType?
  entityId   String?
  actionUrl  String?
  createdAt  DateTime                 @default(now())
  recipients NotificationRecipients[]

  @@index([schoolId, createdAt])
}

model NotificationRecipients {
  id             String        @id @default(uuid())
  notificationId String
  notification   Notifications @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead         Boolean       @default(false)
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@unique([notificationId, userId])
  @@index([userId, isRead])
}

enum NotificationType {
  ANNOUNCEMENT
  FEE_REMINDER
  ATTENDANCE_ALERT
  EXAM_SCHEDULED
  TIMETABLE_CHANGE
  REPORT_CARD_READY
  GENERAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationEntityType {
  ANNOUNCEMENT
  FEE
  EXAM
  TEST
  ASSIGNMENT
  TIMETABLE
  EVENT
  REPORT_CARD
}

enum NotificationIcon {
  MEGAPHONE_FILL
  CASH_COIN
  CASH_STACK
  PERSON_FILL_EXCLAMATION
  JOURNAL_CHECK
  PENCIL_SQUARE
  CALENDAR2_WEEK_FILL
  CALENDAR_EVENT_FILL
  CLIPBOARD2_CHECK_FILL
  FILE_EARMARK_BAR_GRAPH_FILL
  INFO_CIRCLE_FILL
}

enum NotificationColor {
  GREEN
  YELLOW
  ORANGE
  RED
  PURPLE
  TEAL
  PINK
  INDIGO
}

enum Gender {
  MALE
  FEMALE
}

enum SchoolStatus {
  ACTIVE
  BLOCKED
  PENDING
  APPROVED
  REJECTED
}

enum SubjectStatus {
  ACTIVE
  PURSED
}

enum UserCondition {
  BLOCKED
  DELETED
  ACTIVE
  DEACTIVATED
  SUSPENDED
  EXPELLED
  GRADUATED
  MUTUALEXIT
  SACKED
  LEAVE
  PENDING
  TRANSFERED
}

enum ClassCondition {
  ACTIVE
  DELETED
  CLOSED
  SUSPENDED
}

enum ReportCardState {
  COMPLETED
  INCOMPLETE
}

enum Duration {
  UPCOMING
  STARTED
  ONGOING
  ENDED
}

enum FeeStatus {
  PARTIAL
  PAID
  UNPAID
}

enum FeeCategory {
  COMPULSORY
  OPTIONAL
}

enum SubjectCategory {
  CORE
  ELECTIVE
  CO_CURRICULAR
}

enum AnnouncementStatus {
  PUBLISHED
  EXPIRED
  PENDING
}

enum SchoolType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum SchoolSetup {
  SINGLE
  GROUP
  DANIRA
}

enum StaffStatus {
  PERTIME
  FULLTIME
  VISITING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum ClassType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
}

enum PeriodType {
  TEACHING
  LECTURE
  STUDY
  BREAK
  BREAKFAST
  LUNCH
  DINNER
  ASSEMBLY
  RELIGIOUS
  CO_CURRICULAR
  TEST
  EXAM
}

enum Currency {
  NGN
  USD
  KES
  GBP
  GHS
  EUR
  ZAR
  CAD
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Role {
  SUPERADMIN
  DANIRAADMIN
  SCHOOLADMIN
  GROUPSCHOOLADMIN
  SUBSCHOOLADMIN
  SCHOOLSTAFF
  STUDENT
  GUARDIAN
}

enum Accomodation {
  ONCAMPUS
  OFFCAMPUS
  STAFFQUARTERS
}

enum TermType {
  FIRSTTERM
  SECONDTERM
  THIRDTERM
  FIRSTSEMESTER
  SECONDSEMESTER
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}
