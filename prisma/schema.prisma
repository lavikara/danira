generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id          String        @id @default(uuid())
  username    String        @unique
  email       String        @unique
  password    String
  firstName   String
  lastName    String
  designation String?
  phoneNumber String
  country     String
  state       String
  address     String
  isVerified  Boolean
  gender      Gender
  role        Role
  status      UserCondition
  ratings     Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  admins      Admins?
  staffs      Staffs?
  students    Students?
  guardians   Guardians?
}

model Admins {
  id        String        @id @default(uuid())
  userId    String        @unique
  type      SchoolSetup?
  schoolIds String[]
  schools   Schools[]
  groupId   String?
  group     SchoolGroups? @relation(fields: [groupId], references: [id])
  users     Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolGroups {
  id        String       @id @default(uuid())
  groupName String       @unique
  status    SchoolStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admins    Admins[]
  schools   Schools[]
}

model Schools {
  id              String          @id @default(uuid())
  type            SchoolType
  setup           SchoolSetup
  schoolName      String          @unique
  regNumber       String?
  address         String
  phoneNumber     String
  country         String
  state           String
  createdBy       String?
  approvedBy      String?
  isApproved      Boolean
  termsConditions Boolean
  status          SchoolStatus
  email           String          @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  staffs          Staffs[]
  students        Students[]
  admins          Admins[]
  departments     Departments[]
  feeStructures   FeeStructures[]
  fees            Fees[]
  groupId         String?
  group           SchoolGroups?   @relation(fields: [groupId], references: [id])
}

model Departments {
  id          String           @id @default(uuid())
  name        String
  code        String?
  description String?
  status      DepartmentStatus @default(ACTIVE)
  schoolId    String
  school      Schools          @relation(fields: [schoolId], references: [id])
  headId      String?          @unique
  head        Staffs?          @relation("DepartmentHead", fields: [headId], references: [id])
  staffs      Staffs[]         @relation("DepartmentStaffs")
  subjects    Subjects[]
  classes     Classes[]
  students    Students[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([schoolId, name])
}

model Staffs {
  id               String        @id @default(uuid())
  staffId          String?
  position         String
  image            String?
  accomodation     Accomodation?
  employmentStatus StaffStatus
  attendances      Attendance[]
  subjects         Subjects[]
  classes          Classes[]
  lessons          Lessons[]
  schoolId         String
  school           Schools       @relation(fields: [schoolId], references: [id])
  userId           String        @unique
  users            Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId     String?
  department       Departments?  @relation("DepartmentStaffs", fields: [departmentId], references: [id])
  headOfDepartment Departments?  @relation("DepartmentHead")
}

model Students {
  id           String        @id @default(uuid())
  position     String
  studentId    String?
  image        String?
  accomodation Accomodation?
  attendances  Attendance[]
  reportCard   ReportCards[]
  fees         Fees[]
  classId      String
  class        Classes       @relation(fields: [classId], references: [id])
  guardianId   String
  guardian     Guardians     @relation(fields: [guardianId], references: [id])
  schoolId     String?
  school       Schools?      @relation(fields: [schoolId], references: [id])
  gradeYearId  String?
  gradeYear    GradeYears?   @relation(fields: [gradeYearId], references: [id])
  examId       String?
  exam         Exams?        @relation(fields: [examId], references: [id])
  testId       String?
  test         Tests?        @relation(fields: [testId], references: [id])
  assignmentId String?
  assignment   Assignments?  @relation(fields: [assignmentId], references: [id])
  subjects     Subjects[]
  departmentId String?
  department   Departments?  @relation(fields: [departmentId], references: [id])
  userId       String        @unique
  users        Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guardians {
  id       String     @id @default(uuid())
  userId   String     @unique
  students Students[]
  users    Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Classes {
  id            String          @id @default(uuid())
  name          String
  type          ClassType
  status        ClassCondition
  description   String?
  population    Int
  supervisorId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  supervisor    Staffs          @relation(fields: [supervisorId], references: [id])
  lessons       Lessons[]
  subjects      Subjects[]
  students      Students[]
  events        Events[]
  announcements Announcements[]
  fees          Fees[]
  gradeYearId   String?
  gradeYear     GradeYears?     @relation(fields: [gradeYearId], references: [id])
  departmentId  String?
  department    Departments?    @relation(fields: [departmentId], references: [id])
}

model Assignments {
  id        String     @id @default(uuid())
  title     String
  startTime DateTime
  dueDate   DateTime
  status    Duration
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lessons   Lessons[]
  students  Students[]
}

model Exams {
  id        String     @id @default(uuid())
  title     String
  status    Duration
  startTime DateTime
  endTime   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  subjects  Subjects[]
  students  Students[]
}

model Tests {
  id        String     @id @default(uuid())
  title     String
  status    Duration
  startTime DateTime
  endTime   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  subjects  Subjects[]
  students  Students[]
}

model GradeYears {
  id        String     @id @default(uuid())
  level     String
  start     DateTime
  end       DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  students  Students[]
  classes   Classes[]
  terms     Terms[]
}

model Terms {
  id          String      @id @default(uuid())
  name        String
  start       DateTime
  end         DateTime
  status      Duration
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  type        TermType
  gradeYearId String?
  gradeYear   GradeYears? @relation(fields: [gradeYearId], references: [id])
}

model Attendance {
  id         String           @id @default(uuid())
  date       DateTime
  attendance AttendanceStatus
  status     Duration
  clockIn    DateTime
  clockOut   DateTime
  studentId  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  student    Students         @relation(fields: [studentId], references: [id])
  lessonId   String?
  lesson     Lessons?         @relation(fields: [lessonId], references: [id])
  staffs     Staffs?          @relation(fields: [staffsId], references: [id])
  staffsId   String?
}

model Subjects {
  id           String          @id @default(uuid())
  name         String
  category     SubjectCategory
  description  String?
  code         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  status       SubjectStatus
  staffs       Staffs[]
  lessons      Lessons[]
  students     Students[]
  examId       String?
  exam         Exams?          @relation(fields: [examId], references: [id])
  testId       String?
  test         Tests?          @relation(fields: [testId], references: [id])
  reportCardId String?
  reportCard   ReportCards?    @relation(fields: [reportCardId], references: [id])
  departmentId String?
  department   Departments?    @relation(fields: [departmentId], references: [id])
  classes      Classes?        @relation(fields: [classesId], references: [id])
  classesId    String?
}

model Lessons {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String?
  day          Day
  status       Duration
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendances  Attendance[]
  subject      Subjects     @relation(fields: [subjectId], references: [id])
  subjectId    String
  class        Classes      @relation(fields: [classId], references: [id])
  classId      String
  staff        Staffs       @relation(fields: [staffId], references: [id])
  staffId      String
  assignmentId String?
  assignment   Assignments? @relation(fields: [assignmentId], references: [id])
}

model ReportCards {
  id              String          @id @default(uuid())
  testScore       Float
  assignmentScore Float
  examScore       Float
  attendanceScore Float
  status          ReportCardState
  teacherComment  String
  generalComment  String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subjects        Subjects[]
  studentId       String?
  student         Students?       @relation(fields: [studentId], references: [id])
}

/// A school's own catalog of fee types — the "menu" of compulsory and
/// optional fees it charges, before any individual student is billed.
/// Compulsory entries (tuition, library, books, etc.) are expected to be
/// charged to every student at that school; optional entries (transport,
/// lunch, etc.) are charged only to students who opt in. `classType` lets a
/// school scope a fee to a particular class type (e.g. a boarding fee that
/// only applies to SECONDARY classes) — leave it null for a fee that
/// applies across all of the school's classes.
model FeeStructures {
  id          String      @id @default(uuid())
  name        String
  description String?
  category    FeeCategory
  amount      Float
  classType   ClassType?
  schoolId    String
  school      Schools     @relation(fields: [schoolId], references: [id])
  fees        Fees[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([schoolId, name])
}

/// `paid` + `outstanding` always sum to `amount`. A student's overall fee
/// payment status is derived, not stored: they count as having "paid" once
/// every one of their COMPULSORY Fees rows has `status = PAID` (equivalently
/// `outstanding = 0` on all of them) — OPTIONAL fees don't factor into that
/// rule.
model Fees {
  id             String         @id @default(uuid())
  name           String
  description    String?
  receipt        String?
  amount         Float
  paid           Float          @default(0)
  outstanding    Float          @default(0)
  category       FeeCategory
  status         FeeStatus
  studentId      String?
  student        Students?      @relation(fields: [studentId], references: [id])
  schoolId       String
  school         Schools        @relation(fields: [schoolId], references: [id])
  classId        String?
  class          Classes?       @relation(fields: [classId], references: [id])
  feeStructureId String?
  feeStructure   FeeStructures? @relation(fields: [feeStructureId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Events {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      Duration
  date        DateTime
  duration    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Classes? @relation(fields: [classId], references: [id])
  classId     String?
}

model Announcements {
  id          String             @id @default(uuid())
  title       String
  description String?
  status      AnnouncementStatus
  date        DateTime
  class       Classes?           @relation(fields: [classId], references: [id])
  classId     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

enum SchoolStatus {
  ACTIVE
  BLOCKED
  PENDING
  APPROVED
  REJECTED
}

enum SubjectStatus {
  ACTIVE
  PURSED
}

enum UserCondition {
  BLOCKED
  DELETED
  ACTIVE
  DEACTIVATED
  SUSPENDED
  EXPELLED
  GRADUATED
  MUTUALEXIT
  SACKED
  LEAVE
  PENDING
  TRANSFERED
}

enum ClassCondition {
  ACTIVE
  DELETED
  CLOSED
  SUSPENDED
}

enum ReportCardState {
  COMPLETED
  INCOMPLETE
}

enum Duration {
  UPCOMING
  STARTED
  ONGOING
  ENDED
}

enum FeeStatus {
  PARTIAL
  PAID
  UNPAID
}

enum FeeCategory {
  COMPULSORY
  OPTIONAL
}

enum SubjectCategory {
  COMPULSORY
  OPTIONAL
  ELECTIVE
}

enum AnnouncementStatus {
  PUBLISHED
  EXPIRED
  PENDING
}

enum SchoolType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum SchoolSetup {
  SINGLE
  GROUP
  DANIRA
}

enum StaffStatus {
  PERTIME
  FULLTIME
  VISITING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ClassType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Role {
  SUPERADMIN
  DANIRAADMIN
  SCHOOLADMIN
  GROUPSCHOOLADMIN
  SUBSCHOOLADMIN
  SCHOOLSTAFF
  STUDENT
  GUARDIAN
}

enum Accomodation {
  ONCAMPUS
  OFFCAMPUS
  STAFFQUARTERS
}

enum TermType {
  FIRSTTERM
  SECONDTERM
  THIRDTERM
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}
