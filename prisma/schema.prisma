generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id          String        @id @default(uuid())
  username    String        @unique
  email       String        @unique
  password    String
  firstName   String
  lastName    String
  designation String?
  phoneNumber String
  country     String
  state       String
  address     String
  isVerified  Boolean
  gender      Gender
  role        Role
  status      UserCondition
  ratings     Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  admins      Admins?
  staffs      Staffs?
  students    Students?
  guardians   Guardians?
}

model Admins {
  id        String        @id @default(uuid())
  userId    String        @unique
  type      SchoolSetup?
  schoolIds String[]
  schools   Schools[]
  groupId   String?
  group     SchoolGroups? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  users     Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolGroups {
  id        String       @id @default(uuid())
  groupName String       @unique
  status    SchoolStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  admins    Admins[]
  schools   Schools[]
}

model Schools {
  id                 String              @id @default(uuid())
  type               SchoolType
  setup              SchoolSetup
  schoolName         String              @unique
  regNumber          String?
  address            String
  phoneNumber        String
  country            String
  state              String
  createdBy          String?
  approvedBy         String?
  isApproved         Boolean
  termsConditions    Boolean
  status             SchoolStatus
  email              String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  classes            Classes[]
  staffs             Staffs[]
  students           Students[]
  admins             Admins[]
  departments        Departments[]
  subjects           Subjects[]
  feeStructures      FeeStructures[]
  fees               Fees[]
  receipts           Receipt[]
  timetables         Timetables[]
  groupId            String?
  group              SchoolGroups?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  studentAttendances StudentAttendance[]
  staffAttendances   StaffAttendance[]
}

model Departments {
  id          String           @id @default(uuid())
  name        String
  code        String?
  description String?
  status      DepartmentStatus @default(ACTIVE)
  schoolId    String
  school      Schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  headId      String?          @unique
  head        Staffs?          @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  staffs      Staffs[]         @relation("DepartmentStaffs")
  subjects    Subjects[]
  classes     Classes[]
  students    Students[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([schoolId, name])
}

model Staffs {
  id                String             @id @default(uuid())
  staffId           String?
  position          String
  image             String?
  accomodation      Accomodation?
  employmentStatus  StaffStatus
  subjectOfferings  ClassSubjects[]
  classes           Classes[]
  lessons           Lessons[]
  receiptsIssued    Receipt[]
  schoolId          String
  school            Schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId            String             @unique
  users             Users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Departments?       @relation("DepartmentStaffs", fields: [departmentId], references: [id], onDelete: SetNull)
  headOfDepartment  Departments?       @relation("DepartmentHead")
  staffAttendances  StaffAttendance[]
  lessonAttendances LessonAttendance[]
}

model Students {
  id           String              @id @default(uuid())
  position     String
  studentId    String?
  image        String?
  accomodation Accomodation?
  attendances  StudentAttendance[]
  reportCard   ReportCards[]
  fees         Fees[]
  receipts     Receipt[]
  classId      String
  class        Classes             @relation(fields: [classId], references: [id], onDelete: Restrict)
  guardianId   String
  guardian     Guardians           @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  schoolId     String?
  school       Schools?            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeYearId  String?
  gradeYear    GradeYears?         @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  examId       String?
  exam         Exams?              @relation(fields: [examId], references: [id], onDelete: SetNull)
  testId       String?
  test         Tests?              @relation(fields: [testId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignments?        @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  subjects     Subjects[]
  departmentId String?
  department   Departments?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId       String              @unique
  users        Users               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guardians {
  id       String     @id @default(uuid())
  userId   String     @unique
  students Students[]
  users    Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Classes {
  id               String          @id @default(uuid())
  name             String
  type             ClassType
  status           ClassCondition
  description      String?
  population       Int
  supervisorId     String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  supervisor       Staffs          @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  lessons          Lessons[]
  subjectOfferings ClassSubjects[]
  students         Students[]
  events           Events[]
  announcements    Announcements[]
  fees             Fees[]
  timetables       Timetables[]
  gradeYearId      String?
  gradeYear        GradeYears?     @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Departments?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  school           Schools?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId         String?
}

/// A timetable is the container for one school's (optionally one class/grade-year/term's)
/// weekly schedule. Deleting a school takes its timetables with it; deleting a class,
/// grade year, or term just detaches the timetable rather than destroying it.
model Timetables {
  id          String             @id @default(uuid())
  name        String
  status      Duration           @default(UPCOMING)
  schoolId    String
  school      Schools            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String?
  class       Classes?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  gradeYearId String?
  gradeYear   GradeYears?        @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  termId      String?
  term        Terms?             @relation(fields: [termId], references: [id], onDelete: SetNull)
  periods     TimetablePeriods[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([schoolId, classId, termId])
}

/// A single scheduled slot within a timetable (e.g. Monday 8:00-8:40, TEACHING period).
/// Optionally links to the actual Lesson occupying that slot; non-teaching periods
/// (breaks, assembly, lunch) simply leave lessonId null.
model TimetablePeriods {
  id          String     @id @default(uuid())
  name        String
  day         Day
  startTime   DateTime
  endTime     DateTime
  periodType  PeriodType
  timetableId String
  timetable   Timetables @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lessons?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([timetableId, day, startTime])
}

model Assignments {
  id        String     @id @default(uuid())
  title     String
  startTime DateTime
  dueDate   DateTime
  status    Duration
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lessons   Lessons[]
  students  Students[]
}

model Exams {
  id        String     @id @default(uuid())
  title     String
  status    Duration
  startTime DateTime
  endTime   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  subjects  Subjects[]
  students  Students[]
}

model Tests {
  id        String     @id @default(uuid())
  title     String
  status    Duration
  startTime DateTime
  endTime   DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  subjects  Subjects[]
  students  Students[]
}

model GradeYears {
  id         String       @id @default(uuid())
  level      String
  start      DateTime
  end        DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  students   Students[]
  classes    Classes[]
  terms      Terms[]
  timetables Timetables[]
}

model Terms {
  id          String       @id @default(uuid())
  name        String
  start       DateTime
  end         DateTime
  status      Duration
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  type        TermType
  gradeYearId String?
  gradeYear   GradeYears?  @relation(fields: [gradeYearId], references: [id], onDelete: SetNull)
  timetables  Timetables[]
}

/// A student's attendance for the school day generally (lessonId null) or for a
/// specific lesson occurrence (lessonId set). clockIn/clockOut are optional since
/// an ABSENT record has no real timestamps to capture.
model StudentAttendance {
  id         String           @id @default(uuid())
  date       DateTime         @db.Date
  attendance AttendanceStatus
  clockIn    DateTime?
  clockOut   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  schoolId   String
  school     Schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Students         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lessons?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([studentId, lessonId, date])
  @@index([schoolId, date])
}

/// A staff member's daily attendance at the school — clocking in on arrival and
/// clocking out on departure. One row per staff member per day.
model StaffAttendance {
  id        String           @id @default(uuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  clockIn   DateTime?
  clockOut  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  schoolId  String
  school    Schools          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staffs           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([schoolId, date])
}

/// A teaching staff member's clock-in/out for a specific lesson occurrence.
/// Distinct from StaffAttendance (whole school day) — a teacher present at
/// school all day can still be late to, or miss, an individual period. staffId
/// is kept explicit (rather than inferred from lesson.staffId) so substitute
/// teachers can log attendance for a lesson they're covering.
model LessonAttendance {
  id        String           @id @default(uuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  clockIn   DateTime?
  clockOut  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lessonId  String
  lesson    Lessons          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staffs           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([lessonId, staffId, date])
  @@index([staffId, date])
}

/// Subject master data — one row per subject per school (e.g. "Mathematics" at
/// Greenwood High). Which classes offer it and who teaches it there is modeled
/// via ClassSubjects, not duplicated as separate Subjects rows per class.
model Subjects {
  id           String          @id @default(uuid())
  name         String
  category     SubjectCategory
  description  String?
  code         String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  status       SubjectStatus
  students     Students[]
  exams        Exams[]
  tests        Tests[]
  reportCards  ReportCards[]
  offerings    ClassSubjects[]
  schoolId     String
  school       Schools         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Departments?    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lessons      Lessons[]

  @@unique([schoolId, name])
  @@index([departmentId])
}

/// Join model representing "this class offers this subject", optionally taught
/// by a specific staff member. Lessons (scheduled sessions) reference class,
/// subject, and staff directly for query performance, but should stay
/// consistent with whichever ClassSubjects row represents the same offering.
model ClassSubjects {
  id        String    @id @default(uuid())
  classId   String
  class     Classes   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subjects  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staffs?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  lessons   Lessons[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([staffId])
}

model Lessons {
  id                 String              @id @default(uuid())
  name               String              @unique
  description        String?
  day                Day
  status             Duration
  startTime          DateTime
  endTime            DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  studentAttendances StudentAttendance[]
  lessonAttendances  LessonAttendance[]
  subject            Subjects            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId          String
  class              Classes             @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId            String
  staff              Staffs              @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId            String
  classSubjectId     String?
  classSubject       ClassSubjects?      @relation(fields: [classSubjectId], references: [id], onDelete: SetNull)
  assignmentId       String?
  assignment         Assignments?        @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  timetablePeriods   TimetablePeriods[]
}

model ReportCards {
  id              String          @id @default(uuid())
  testScore       Float
  assignmentScore Float
  examScore       Float
  attendanceScore Float
  status          ReportCardState
  teacherComment  String
  generalComment  String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subjects        Subjects[]
  studentId       String?
  student         Students?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FeeStructures {
  id          String      @id @default(uuid())
  name        String
  description String?
  category    FeeCategory
  amount      Float
  classType   ClassType?
  schoolId    String
  school      Schools     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fees        Fees[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([schoolId, name])
}

model Fees {
  id             String         @id @default(uuid())
  name           String
  description    String?
  amount         Float
  paid           Float          @default(0)
  outstanding    Float          @default(0)
  category       FeeCategory
  status         FeeStatus
  currency       Currency
  studentId      String?
  student        Students?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId       String
  school         Schools        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String?
  class          Classes?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  feeStructureId String?
  feeStructure   FeeStructures? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  receipt        Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  receiptId      String?
}

/// A record of an actual payment. One Receipt can cover several Fees
/// (e.g. a parent pays tuition + library fee in one transaction), so the
/// relation to Fees stays one-to-many. amount is the total the receipt
/// covers, which should equal the sum of `paid` across its linked Fees.
model Receipt {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  amount        Float
  currency      Currency
  paymentMethod PaymentMethod
  notes         String?
  studentId     String
  student       Students      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId      String
  school        Schools       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issuedById    String?
  issuedBy      Staffs?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  fees          Fees[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Events {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      Duration
  date        DateTime
  duration    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Classes? @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId     String?
}

model Announcements {
  id          String             @id @default(uuid())
  title       String
  description String?
  status      AnnouncementStatus
  date        DateTime
  class       Classes?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

enum SchoolStatus {
  ACTIVE
  BLOCKED
  PENDING
  APPROVED
  REJECTED
}

enum SubjectStatus {
  ACTIVE
  PURSED
}

enum UserCondition {
  BLOCKED
  DELETED
  ACTIVE
  DEACTIVATED
  SUSPENDED
  EXPELLED
  GRADUATED
  MUTUALEXIT
  SACKED
  LEAVE
  PENDING
  TRANSFERED
}

enum ClassCondition {
  ACTIVE
  DELETED
  CLOSED
  SUSPENDED
}

enum ReportCardState {
  COMPLETED
  INCOMPLETE
}

enum Duration {
  UPCOMING
  STARTED
  ONGOING
  ENDED
}

enum FeeStatus {
  PARTIAL
  PAID
  UNPAID
}

enum FeeCategory {
  COMPULSORY
  OPTIONAL
}

enum SubjectCategory {
  CORE
  ELECTIVE
  CO_CURRICULAR
}

enum AnnouncementStatus {
  PUBLISHED
  EXPIRED
  PENDING
}

enum SchoolType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum SchoolSetup {
  SINGLE
  GROUP
  DANIRA
}

enum StaffStatus {
  PERTIME
  FULLTIME
  VISITING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum ClassType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
}

enum PeriodType {
  TEACHING
  LECTURE
  STUDY
  BREAK
  BREAKFAST
  LUNCH
  DINNER
  ASSEMBLY
  RELIGIOUS
  CoCURRICULAR
  TEST
  EXAM
}

enum Currency {
  NGN
  USD
  KES
  GBP
  GHS
  EUR
  ZAR
  CAD
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Role {
  SUPERADMIN
  DANIRAADMIN
  SCHOOLADMIN
  GROUPSCHOOLADMIN
  SUBSCHOOLADMIN
  SCHOOLSTAFF
  STUDENT
  GUARDIAN
}

enum Accomodation {
  ONCAMPUS
  OFFCAMPUS
  STAFFQUARTERS
}

enum TermType {
  FIRSTTERM
  SECONDTERM
  THIRDTERM
  FIRSTSEMESTER
  SECONDSEMESTER
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}
