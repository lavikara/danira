// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  firstName String
  lastName  String
  password  String
  role      Role
  gender    Gender
  createdAt DateTime @default(now())
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  Int?
}

model School {
  id          Int        @id @default(autoincrement())
  type        SchoolType
  name        String     @unique
  address     String
  phoneNumber String
  email       String     @unique

  staffs   Staff[]
  students Student[]
  admins   Admin[]
}

model Staff {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  password     String
  firstName    String
  lastName     String
  phoneNumber  String
  position     String
  image        String?
  depertment   String?
  accomodation Accomodation?
  status       StaffStatus
  gender       Gender
  address      String
  createdAt    DateTime      @default(now())
  role         Role

  subjects Subject[]
  classes  Class[]
  lessons  Lesson[]
  schoolId Int?
  school   School?   @relation(fields: [schoolId], references: [id])
}

model Student {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  firstName    String
  lastName     String
  password     String
  address      String
  image        String?
  phoneNumber  String?
  accomodation Accomodation?
  gender       Gender
  createdAt    DateTime      @default(now())
  role         Role

  attendances  Attendance[]
  reportCard   ReportCard[]
  fees         Fees[]
  classId      Int
  class        Class        @relation(fields: [classId], references: [id])
  guardianId   String
  guardian     Guardian     @relation(fields: [guardianId], references: [id])
  schoolId     Int?
  school       School?      @relation(fields: [schoolId], references: [id])
  gradeYearId  Int?
  gradeYear    GradeYear?   @relation(fields: [gradeYearId], references: [id])
  examId       Int?
  exam         Exam?        @relation(fields: [examId], references: [id])
  testId       Int?
  test         Test?        @relation(fields: [testId], references: [id])
  assignmentId Int?
  assignment   Assignment?  @relation(fields: [assignmentId], references: [id])
  subjectId    Int?
  subject      Subject?     @relation(fields: [subjectId], references: [id])
}

model Guardian {
  id          String   @id @default(uuid())
  username    String   @unique
  email       String   @unique
  firstName   String
  lastName    String
  phoneNumber String
  address     String
  password    String
  gender      Gender
  createdAt   DateTime @default(now())
  role        Role

  students Student[]
}

model Class {
  id            Int            @id @default(autoincrement())
  name          String
  type          ClassType
  description   String?
  population    Int
  supervisorId  String
  supervisor    Staff          @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  events        Event[]
  announcements Announcement[]
  gradeYearId   Int?
  gradeYear     GradeYear?     @relation(fields: [gradeYearId], references: [id])
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  dueDate   DateTime

  lessons  Lesson[]
  students Student[]
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  subjects Subject[]
  students Student[]
}

model Test {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  subjects Subject[]
  students Student[]
}

model GradeYear {
  id    Int      @id @default(autoincrement())
  level String
  start DateTime
  end   DateTime

  students Student[]
  classes  Class[]
  terms    Term[]
}

model Term {
  id          Int        @id @default(autoincrement())
  name        String
  start       DateTime
  end         DateTime
  type        TermType
  gradeYearId Int?
  gradeYear   GradeYear? @relation(fields: [gradeYearId], references: [id])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime
  status    AttendanceStatus
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  lessonId  Int?
  lesson    Lesson?          @relation(fields: [lessonId], references: [id])
}

model Subject {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  code         String?
  staffs       Staff[]
  lessons      Lesson[]
  students     Student[]
  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  testId       Int?
  test         Test?       @relation(fields: [testId], references: [id])
  reportCardId Int?
  reportCard   ReportCard? @relation(fields: [reportCardId], references: [id])
}

model Lesson {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  day         Day
  startTime   DateTime
  endTime     DateTime

  attendances  Attendance[]
  subject      Subject      @relation(fields: [subjectId], references: [id])
  subjectId    Int
  class        Class        @relation(fields: [classId], references: [id])
  classId      Int
  staff        Staff        @relation(fields: [staffId], references: [id])
  staffId      String
  assignmentId Int?
  assignment   Assignment?  @relation(fields: [assignmentId], references: [id])
}

model ReportCard {
  id              Int       @id @default(autoincrement())
  testScore       Float
  assignmentScore Float
  examScore       Float
  attendanceScore Float
  teacherComment  String
  generalComment  String
  subjects        Subject[]
  studentId       String?
  student         Student?  @relation(fields: [studentId], references: [id])
}

model Fees {
  id          String   @id @default(uuid())
  name        String
  description String?
  receipt     String?
  amount      Float
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  duration    String
  class       Class?   @relation(fields: [classId], references: [id])
  classId     Int?
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  class       Class?   @relation(fields: [classId], references: [id])
  classId     Int?
}

enum Gender {
  MALE
  FEMALE
}

enum SchoolType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum StaffStatus {
  PERTIME
  FULLTIME
  VISITING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ClassType {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Role {
  SUPERADMIN
  PLATFORMADMIN
  SCHOOLADMIN
  SUBSCHOOLADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum Accomodation {
  ONCAMPUS
  OFFCAMPUS
  STAFFQUARTERS
}

enum TermType {
  FIRSTTERM
  SECONDTERM
  THIRDTERM
}
